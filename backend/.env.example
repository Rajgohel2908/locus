# Security & Documentation
# Set to 1 to enable interactive Swagger docs at /docs in development.
# Set to 0 in production to hide /docs, /redoc, and /openapi.json.
ENABLE_DOCS=0

# Database connection
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/locus

# Phase 4 RAG Configuration
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SCORE=0.30
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30
 
# Phase 5 Retrieval & Reranking Configuration
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CANDIDATES_N=20
RRF_K=60
RERANK_TOP_N=20
MIN_BM25=0.5
MIN_RERANK=0.50
